# Скопируйте в .env и впишите ключ: cp .env.example .env
GROQ_API_KEY=

# Любой OpenAI-совместимый API: OpenAI, vLLM, Ollama (http://host.docker.internal:11434/v1), OpenRouter
# RAG_LLM_BASE_URL=https://api.groq.com/openai/v1
# RAG_LLM_MODEL=openai/gpt-oss-20b
# RAG_LLM_EXTRA={"reasoning_effort": "low"}

# Ключ для доступа к API (заголовок X-API-Key); пусто — без ключа
# RAG_API_KEY=

# Поиск
# RAG_RETRIEVAL_MODE=hybrid
# RAG_RERANK=true
# RAG_TOP_K=5

# Семантический кэш: включайте, только проверив порог (rag eval cache)
# RAG_SEMANTIC_CACHE=false
# RAG_SEMANTIC_CACHE_THRESHOLD=0.97
